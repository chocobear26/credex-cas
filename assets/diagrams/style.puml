' Gemeinsamer Stil für alle PlantUML-Diagramme. layouts/_markup/render-image.html fügt diesen Block
' beim Build direkt nach der @startuml-Zeile jedes Diagramms ein; die .puml-Dateien selbst tragen
' keinen eigenen Stil. Farben: Schiefer für Struktur, Rot für «neu», Akteurfarben wie im Soll-Prozess.
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam defaultFontColor #0F172A
skinparam shadowing false
skinparam roundCorner 12
skinparam padding 2
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 11
skinparam TitleFontSize 17
skinparam TitleFontStyle bold
skinparam TitleFontColor #0F172A
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #F59E0B
skinparam NoteFontColor #78350F
skinparam NoteFontSize 11
hide circle
hide empty members
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  HeaderBackgroundColor #F1F5F9
  FontStyle bold
  FontSize 14
  AttributeFontColor #334155
  AttributeFontSize 12
  StereotypeFontColor #B91C1C
  StereotypeFontSize 10
}
skinparam class<<neu>> {
  BackgroundColor #FFFFFF
  BorderColor #DC2626
  HeaderBackgroundColor #FEE2E2
}
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontSize 12
  DiamondBackgroundColor #FFF7ED
  DiamondBorderColor #F59E0B
  DiamondFontSize 11
  StartColor #1E293B
  EndColor #1E293B
  BarColor #1E293B
}
skinparam swimlane {
  BorderColor #CBD5E1
  BorderThickness 1
  TitleFontStyle bold
  TitleFontSize 13
  TitleFontColor #1E293B
  Width same
}
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontStyle bold
  FontSize 13
  AttributeFontColor #64748B
  AttributeFontSize 11
  StartColor #1E293B
  EndColor #1E293B
}
skinparam usecase {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  FontSize 12
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontStyle bold
  FontSize 12
}
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontStyle bold
  FontColor #475569
}
