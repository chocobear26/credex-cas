<bpmn:process id="Proc_2" isExecutable="false">
<bpmn:laneSet id="LS_2">
<bpmn:lane id="L2_b" name="Berater/in"><bpmn:flowNodeRef>lc</bpmn:flowNodeRef><bpmn:flowNodeRef>t31</bpmn:flowNodeRef><bpmn:flowNodeRef>m32</bpmn:flowNodeRef><bpmn:flowNodeRef>g32</bpmn:flowNodeRef><bpmn:flowNodeRef>t33</bpmn:flowNodeRef><bpmn:flowNodeRef>m41</bpmn:flowNodeRef><bpmn:flowNodeRef>g41</bpmn:flowNodeRef><bpmn:flowNodeRef>t41a</bpmn:flowNodeRef><bpmn:flowNodeRef>t41b</bpmn:flowNodeRef><bpmn:flowNodeRef>m42</bpmn:flowNodeRef><bpmn:flowNodeRef>t42</bpmn:flowNodeRef></bpmn:lane>
