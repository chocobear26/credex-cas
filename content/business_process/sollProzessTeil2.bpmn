<bpmn:lane id="L2_pm" name="Partnermanagement"><bpmn:flowNodeRef>s6</bpmn:flowNodeRef><bpmn:flowNodeRef>t61</bpmn:flowNodeRef><bpmn:flowNodeRef>e6</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:intermediateCatchEvent id="lc" name="von Teil 1"><bpmn:outgoing>F2_0</bpmn:outgoing><bpmn:linkEventDefinition id="L_lc" name="Teil 2" /></bpmn:intermediateCatchEvent>
<bpmn:task id="t31" name="3.1 Übersicht im CredEx-Tool öffnen"><bpmn:incoming>F2_0</bpmn:incoming><bpmn:outgoing>F2_1</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m32" name=""><bpmn:incoming>F2_1</bpmn:incoming><bpmn:incoming>F2_5</bpmn:incoming><bpmn:outgoing>F2_2</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g32" name="3.2 Zuordnung unsicher?"><bpmn:incoming>F2_2</bpmn:incoming><bpmn:outgoing>F2_3</bpmn:outgoing><bpmn:outgoing>F2_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t33" name="3.3 Dokument ansehen; bestätigen, umordnen oder verwerfen (in der Übersicht oder per Auftrag an die KI)"><bpmn:incoming>F2_3</bpmn:incoming><bpmn:outgoing>F2_4</bpmn:outgoing></bpmn:task>
<bpmn:task id="t34" name="3.4 Zuordnung und Status setzen, Protokolleintrag"><bpmn:incoming>F2_4</bpmn:incoming><bpmn:outgoing>F2_5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m41" name=""><bpmn:incoming>F2_6</bpmn:incoming><bpmn:incoming>F2_10</bpmn:incoming><bpmn:outgoing>F2_7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g41" name="4.1 Alle Pflichtdokumente vorhanden?"><bpmn:incoming>F2_7</bpmn:incoming><bpmn:outgoing>F2_8</bpmn:outgoing><bpmn:outgoing>F2_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t41a" name="4.1a Fehlende Unterlagen selbst beim Kreditnehmer beschaffen"><bpmn:incoming>F2_8</bpmn:incoming><bpmn:outgoing>F2_9</bpmn:outgoing></bpmn:task>
<bpmn:task id="t41b" name="4.1b Nachgelieferte Datei ablegen (KI oder Upload-Feld)"><bpmn:incoming>F2_9</bpmn:incoming><bpmn:outgoing>F2_10</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="m42" name=""><bpmn:incoming>F2_11</bpmn:incoming><bpmn:incoming>F2_17</bpmn:incoming><bpmn:outgoing>F2_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t42" name="4.2 Antrag einreichen"><bpmn:incoming>F2_12</bpmn:incoming><bpmn:outgoing>F2_13</bpmn:outgoing></bpmn:task>
<bpmn:task id="t43" name="4.3 Dossier über bestehende Schnittstelle übermitteln"><bpmn:incoming>F2_13</bpmn:incoming><bpmn:outgoing>F2_14</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="g44" name="4.4 Übermittlung erfolgreich?"><bpmn:incoming>F2_14</bpmn:incoming><bpmn:outgoing>F2_15</bpmn:outgoing><bpmn:outgoing>F2_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t45" name="4.5 Antrag eingereicht setzen, Protokolleintrag"><bpmn:incoming>F2_15</bpmn:incoming><bpmn:outgoing>F2_18</bpmn:outgoing></bpmn:task>
<bpmn:task id="t44a" name="4.4a Antrag bleibt in Erfassung, Meldung an Berater/in"><bpmn:incoming>F2_16</bpmn:incoming><bpmn:outgoing>F2_17</bpmn:outgoing></bpmn:task>
<bpmn:task id="t51" name="5.1 Dossier prüfen (wie heute)"><bpmn:incoming>F2_18</bpmn:incoming><bpmn:outgoing>F2_19</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e1" name="Dossier geprüft"><bpmn:incoming>F2_19</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="s6" name="Monatsende"><bpmn:outgoing>F2_20</bpmn:outgoing><bpmn:timerEventDefinition id="T_s6" /></bpmn:startEvent>
<bpmn:task id="t61" name="6.1 Nutzung und Zeitersparnis pro Partner auswerten"><bpmn:incoming>F2_20</bpmn:incoming><bpmn:outgoing>F2_21</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="e6" name="Kennzahlen ausgewertet"><bpmn:incoming>F2_21</bpmn:incoming></bpmn:endEvent>
