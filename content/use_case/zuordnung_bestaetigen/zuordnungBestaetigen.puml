@startuml zuordnungBestaetigen
title Aktivitätsdiagramm – UC-06 Zuordnung bestätigen oder ändern
|#EFF6FF|Berater/in|
start
:Übersicht des Antrags öffnen;
|#FEFCE8|CredEx-System|
:Unsichere Zuordnungen hervorheben,\nmit Dateiname und Konfidenz;
|Berater/in|
repeat
  :Dokument ansehen;
  switch (Entscheid der Berater/in?)
  case (richtig)
    :Zuordnung bestätigen;
  case (anderes Pflichtdokument)
    :Anderes Pflichtdokument wählen (3a);
  case (passt nicht)
    :Dokument verwerfen (3b);
  endswitch
  |CredEx-System|
  if (Dokument verworfen?) then (nein)
    :Zuordnung setzen (quelle = MENSCH);
    :CredEx-System setzt Dokument\n(status = BESTAETIGT);
  else (ja)
    :CredEx-System setzt Dokument\n(status = VERWORFEN);
  endif
  :Protokolleintrag schreiben (akteur = BERATER);
  |Berater/in|
repeat while (Weitere unsichere Zuordnung?) is (ja) not (nein)
stop

@enduml
